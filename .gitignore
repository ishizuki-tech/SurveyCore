# ============================================================
# Local AI models
# ============================================================
#
# Large model binaries must never be committed to Git.
#
# Match model files in any module or directory named "models".
# The directories themselves remain available for README files,
# metadata, download instructions, and other small text files.
#

**/models/*.litertlm
**/models/*.gguf
**/models/*.bin
**/models/*.safetensors
**/models/*.onnx
**/models/*.tflite


# ============================================================
# Model download temporary files
# ============================================================

**/models/*.part
**/models/*.tmp
**/models/*.download


# ============================================================
# Debug / profiling output
# ============================================================

*.hprof
*.log


# ============================================================
# Signing credentials
# ============================================================
#
# Signing keys and local credential files must never be stored
# in the repository.
#

*.jks
*.keystore
keystore.properties


# ============================================================
# Environment / secret files
# ============================================================

.env
.env.*
!.env.example


# ============================================================
# Miscellaneous temporary / editor files
# ============================================================

*.tmp
*.swp
*.swo
*~


# ============================================================
